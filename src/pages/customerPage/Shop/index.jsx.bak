import React, { useMemo, useState, useEffect } from 'react';
import { Link, useLocation, useNavigate } from 'react-router-dom';
import './style.css';

// Tiny helper to read querystring
function useQuery() {
  return new URLSearchParams(useLocation().search);
}

// Mock product data (replace with API calls later)
const MOCK_PRODUCTS = Array.from({ length: 48 }).map((_, i) => {
  const brands = ['Apple', 'Asus', 'Acer', 'Dell', 'Lenovo'];
  const colors = ['Black', 'Silver', 'White', 'Blue', 'Yellow'];
  const brand = brands[i % brands.length];
  const color = colors[i % colors.length];
  const price = Math.round(200 + (i * 37) % 1500);
  const rating = (i % 5) + 1;
  return {
    id: i + 1,
    title: `${brand} Product ${i + 1}`,
    brand,
    color,
    price,
    rating,
    image: `/assets/images/shop-items/ct${(i % 8) + 1}.png`,
    category: i % 2 === 0 ? 'Electronics' : 'Home & Kitchen'
  };
});

export default function Shop() {
  const query = useQuery();
  const navigate = useNavigate();
  const initialCategory = query.get('category') || '';

  const [category, setCategory] = useState(initialCategory);
  const [search, setSearch] = useState('');
  const [selectedBrands, setSelectedBrands] = useState([]);
  const [priceRange, setPriceRange] = useState([0, 5000]);
  const [selectedColor, setSelectedColor] = useState('');
  const [minRating, setMinRating] = useState(0);
  const [page, setPage] = useState(1);
  const perPage = 12;

  useEffect(() => {
    // keep URL in sync with category
    const params = new URLSearchParams(window.location.search);
    if (category) params.set('category', category);
    else params.delete('category');
    navigate({ search: params.toString() }, { replace: true });
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [category]);

  const brands = useMemo(() => [...new Set(MOCK_PRODUCTS.map(p => p.brand))], []);
  const colors = useMemo(() => [...new Set(MOCK_PRODUCTS.map(p => p.color))], []);

  const filtered = useMemo(() => {
    return MOCK_PRODUCTS.filter(p => {
      if (category && p.category.toLowerCase().indexOf(category.toLowerCase()) === -1) return false;
      if (search && !p.title.toLowerCase().includes(search.toLowerCase())) return false;
      if (selectedBrands.length && !selectedBrands.includes(p.brand)) return false;
      if (selectedColor && p.color !== selectedColor) return false;
      if (p.price < priceRange[0] || p.price > priceRange[1]) return false;
      if (minRating && p.rating < minRating) return false;
      return true;
    });
  }, [category, search, selectedBrands, selectedColor, priceRange, minRating]);

  const totalPages = Math.max(1, Math.ceil(filtered.length / perPage));
  useEffect(() => {
    if (page > totalPages) setPage(1);
  }, [totalPages, page]);

  const pageItems = filtered.slice((page - 1) * perPage, page * perPage);

  const toggleBrand = (b) => {
    setSelectedBrands(prev => prev.includes(b) ? prev.filter(x => x !== b) : [...prev, b]);
  };

  const resetFilters = () => {
    setSelectedBrands([]);
    setPriceRange([0, 5000]);
    setSelectedColor('');
    setMinRating(0);
    setSearch('');
  };

  return (
    <div className="container my-4">
      <div className="row mb-3">
        <div className="col-12 d-flex justify-content-between align-items-center">
          <h3 className="mb-0">Shop</h3>
          <div>
            <label className="me-2">Category:</label>
            <select value={category} onChange={e => setCategory(e.target.value)}>
              <option value="">All</option>
              <option value="Electronics">Electronics</option>
              <option value="Home & Kitchen">Home & Kitchen</option>
            </select>
          </div>
        </div>
      </div>

      <div className="row">
        <aside className="col-lg-3">
          <div className="card p-3 mb-3">
            <h5>Search</h5>
            <input value={search} onChange={e => setSearch(e.target.value)} placeholder="Search products" className="form-control" />
          </div>

          <div className="card p-3 mb-3">
            <h5>Brands</h5>
            {brands.map(b => (
              <div key={b} className="form-check">
                <input className="form-check-input" type="checkbox" id={`brand-${b}`} checked={selectedBrands.includes(b)} onChange={() => toggleBrand(b)} />
                <label className="form-check-label" htmlFor={`brand-${b}`}>{b}</label>
              </div>
            ))}
          </div>

          <div className="card p-3 mb-3">
            <h5>Color</h5>
            <select value={selectedColor} onChange={e => setSelectedColor(e.target.value)} className="form-control">
              <option value="">Any</option>
              {colors.map(c => <option key={c} value={c}>{c}</option>)}
            </select>
          </div>

          <div className="card p-3 mb-3">
            <h5>Rating</h5>
            <select value={minRating} onChange={e => setMinRating(Number(e.target.value))} className="form-control">
              <option value={0}>Any</option>
              <option value={1}>1 & up</option>
              <option value={2}>2 & up</option>
              <option value={3}>3 & up</option>
              <option value={4}>4 & up</option>
            </select>
          </div>

          <div className="d-grid">
            <button className="btn btn-outline-secondary mb-2" onClick={resetFilters}>Reset filters</button>
          </div>
        </aside>

        <section className="col-lg-9">
          <div className="d-flex justify-content-between align-items-center mb-3">
            <div>{filtered.length} results</div>
            <div>
              <label className="me-2">Sort:</label>
              <select onChange={() => {}} className="form-control d-inline-block" style={{ width: '200px' }}>
                <option value="default">Recommended</option>
                <option value="price-asc">Price: Low to High</option>
                <option value="price-desc">Price: High to Low</option>
              </select>
            </div>
          </div>

          <div className="row">
            {pageItems.map(p => (
              <div key={p.id} className="col-6 col-md-4 mb-4">
                <div className="card h-100">
                  <img src={p.image} className="card-img-top" alt={p.title} style={{ objectFit: 'contain', height: 160 }} />
                  <div className="card-body d-flex flex-column">
                    <h6 className="card-title" style={{ fontSize: '0.95rem' }}>{p.title}</h6>
                    <div className="mt-auto">
                      <div className="d-flex justify-content-between align-items-center">
                        <div className="price fw-bold">${p.price}</div>
                        <div className="rating">{Array.from({ length: p.rating }).map((_, i) => <span key={i} style={{ color: '#F5C34B' }}>★</span>)}</div>
                      </div>
                      <div className="mt-2 d-flex gap-2">
                        <Link to={`/product/${p.id}`} className="btn btn-sm btn-primary">View</Link>
                        <button className="btn btn-sm btn-outline-secondary">Add to cart</button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <nav aria-label="Page navigation">
            <ul className="pagination">
              <li className={`page-item ${page === 1 ? 'disabled' : ''}`}><button className="page-link" onClick={() => setPage(p => Math.max(1, p - 1))}>Previous</button></li>
              {Array.from({ length: totalPages }).map((_, i) => (
                <li key={i} className={`page-item ${page === i + 1 ? 'active' : ''}`}><button className="page-link" onClick={() => setPage(i + 1)}>{i + 1}</button></li>
              ))}
              <li className={`page-item ${page === totalPages ? 'disabled' : ''}`}><button className="page-link" onClick={() => setPage(p => Math.min(totalPages, p + 1))}>Next</button></li>
            </ul>
          </nav>
        </section>
      </div>
    </div>
  );
}
